; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="BabbleCalibration"
config/version="1.0.0-alpha1"
run/main_scene="uid://bwo8dbr2ar8cy"
config/features=PackedStringArray("4.5", "C#", "Forward Plus")
boot_splash/bg_color=Color(0.3254902, 0.62352943, 0.54509807, 1)
boot_splash/image="uid://bxsk3vkh76fj0"
config/icon="uid://bxsk3vkh76fj0"
config/windows_native_icon="res://Assets/WindowIcon.ico"

[autoload]

OpenVRInterface="*res://addons/godot-openvr/openvr_autoloader.gd"

[display]

window/size/transparent=true
window/per_pixel_transparency/allowed=true

[dotnet]

project/assembly_name="BabbleCalibration"

[editor]

run/main_run_args="--use-debug --test-routines"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot-openvr/plugin.cfg")

[gui]

theme/default_font_multichannel_signed_distance_field=true
theme/custom_font="uid://bfsw0mbxfwltq"

[internationalization]

locale/translations=PackedStringArray("res://translations.en.translation", "res://translations.es.translation", "res://translations.af.translation", "res://translations.ar.translation", "res://translations.ca.translation", "res://translations.cs.translation", "res://translations.da.translation", "res://translations.de.translation", "res://translations.el.translation", "res://translations.fi.translation", "res://translations.fr.translation", "res://translations.he.translation", "res://translations.hu.translation", "res://translations.it.translation", "res://translations.ja.translation", "res://translations.ko.translation", "res://translations.nl.translation", "res://translations.nb.translation", "res://translations.pl.translation", "res://translations.pt.translation", "res://translations.ro.translation", "res://translations.ru.translation", "res://translations.sr.translation", "res://translations.sv.translation", "res://translations.tr.translation", "res://translations.uk.translation", "res://translations.vi.translation", "res://translations.zh_CN.translation", "res://translations.zh_TW.translation")

[rendering]

renderer/rendering_method="mobile"
anti_aliasing/quality/msaa_3d=2

[xr]

shaders/enabled=true
